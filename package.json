{
  "name": "paalam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paalam: a Gemini-powered bridge that turns messy real-world input into structured, verified, life-saving actions.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "desktop": "vite build && electron .",
    "package": "vite build && electron-builder --mac --dir",
    "install:mac": "npm run package && rm -rf /Applications/Paalam.app && cp -R dist-desktop/mac-arm64/Paalam.app /Applications/ && open /Applications/Paalam.app"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "dotenv": "^17.2.3",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "google-auth-library": "^10.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "multer": "^2.0.2",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/leaflet": "^1.9.20",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "main": "desktop/main.mjs",
  "productName": "Paalam",
  "build": {
    "appId": "app.paalam.desktop",
    "productName": "Paalam",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "dist/**/*",
      "plugins/**/*",
      "knowledge/**/*",
      "package.json",
      "tsconfig.json",
      ".env.example",
      "!**/*.map"
    ],
    "asar": false,
    "npmRebuild": false,
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Paalam records voice notes so Argon can understand what's happening.",
        "NSLocationWhenInUseUsageDescription": "Paalam shares your location with Argon only when you tap the location button, to find help near you."
      }
    }
  }
}
