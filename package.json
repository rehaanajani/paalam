{
  "name": "paalam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paalam: a Gemini-powered bridge that turns messy real-world input into structured, verified, life-saving actions.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "google-auth-library": "^10.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "multer": "^2.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/leaflet": "^1.9.20",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
