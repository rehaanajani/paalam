# ─────────────────────────────────────────────────────────────
# Paalam environment. Copy to `.env` and fill in what you have.
# Anything left blank runs in DEMO mode (clearly labelled in the UI).
# Never commit `.env` or the service-account JSON.
# ─────────────────────────────────────────────────────────────

# ── Gemini ────────────────────────────────────────────────────
# Option A: AI Studio key (aistudio.google.com → Get API key, same project)
GEMINI_API_KEY=

# Option B: Vertex AI via the `paalam` service account (used when GEMINI_API_KEY is blank)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Absolute path to the downloaded service-account JSON (also used by Cloud DLP)
GOOGLE_APPLICATION_CREDENTIALS=

# Models. Argon = the orchestrator (splits, routes). Gems = fast workers.
# The "-latest" aliases follow Google's current models. The Keys screen shows
# whether each ID exists on your key; change any that show a red cross.
ARGON_MODEL=gemini-pro-latest
GEM_MODEL=gemini-flash-latest
# Posters (image generation) and knowledge / similar-report search (embeddings)
IMAGE_MODEL=gemini-3.1-flash-image-preview
EMBED_MODEL=gemini-embedding-001

# ── Google Maps Platform (the `maps-key`) ────────────────────
# Places (New), Routes, Geocoding, Weather, Air Quality, Address Validation
GOOGLE_MAPS_API_KEY=
# Browser-side key for the map tiles (restrict by HTTP referrer). Optional:
# without it the UI uses OpenStreetMap tiles.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# ── Other Google Cloud APIs that accept an API key ────────────
# Cloud Vision (reverse image search), Translation, Text-to-Speech, Safe Browsing.
# Can be the same key as above if you allowed those APIs on it.
GOOGLE_CLOUD_API_KEY=

# ── APIs that use the service account (GOOGLE_APPLICATION_CREDENTIALS) ──
# Cloud DLP masking, Healthcare Natural Language, Model Armor, Firestore
HEALTHCARE_LOCATION=us-central1
# Model Armor: the template ID you create under Security → Model Armor
MODEL_ARMOR_TEMPLATE=
MODEL_ARMOR_LOCATION=us-central1
# Where Bridges are saved: file (data/ on this machine), firestore (Cloud Run), memory
PERSIST=file

# ── Outbound actions (all simulated until set) ───────────────
# SMS / WhatsApp for SOS messages
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Emergency numbers shown on action cards
EMERGENCY_NUMBER=112
AMBULANCE_NUMBER=108
DISASTER_HELPLINE=1070

# ── Browser (read links, open pages, approved form-filling) ──
# Found automatically on macOS (Chrome) and in the Docker image (Chromium).
PAALAM_CHROME_PATH=
# 1 = show the browser window while it fills a form (great for a live demo)
PAALAM_BROWSER_HEADFUL=

# ── Server ───────────────────────────────────────────────────
PORT=8080
DEFAULT_CITY=Chennai
DEFAULT_LAT=13.0827
DEFAULT_LNG=80.2707
